{
  "name": "upmemo",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "check": "npm run test && npm run build && npm run rust:check && npm run rust:clippy && npm audit --audit-level=moderate",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "^2.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  }
}
